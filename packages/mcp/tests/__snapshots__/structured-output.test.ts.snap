  "send_message": {
    "inputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "from": {
          "description": "ID Meta ou UUID interno do Número de origem (obrigatório se a conta tem >1 número).",
          "type": "string",
        },
        "idempotency_key": {
          "description": "Opcional para compatibilidade. Recomendado: chave obtida em prepare_send_intent ou stage_review_reply. Reutilize em retries da mesma intenção; nunca gere outra após timeout. Recusa confirmada (outcome=rejected) libera a chave para repetir após backoff/correção. Nova intenção explícita recebe nova chave.",
          "maxLength": 200,
          "minLength": 8,
          "pattern": "^[!-~]+$",
          "type": "string",
        },
        "interactive": {
          "additionalProperties": {},
          "description": "Objeto interactive da Cloud API quando type='interactive': type 'button' (até 3 botões reply {id,title≤20}), 'list' (action.button + sections[].rows[] {id,title≤24,description?}, até 10 opções) ou 'cta_url' (action {name:'cta_url', parameters {display_text, url https}}); body.text obrigatório; header/footer opcionais. A API valida e recusa com 422 invalid_request.",
          "type": "object",
        },
        "location": {
          "additionalProperties": false,
          "description": "Localização quando type='location'.",
          "properties": {
            "address": {
              "type": "string",
            },
            "latitude": {
              "maximum": 90,
              "minimum": -90,
              "type": "number",
            },
            "longitude": {
              "maximum": 180,
              "minimum": -180,
              "type": "number",
            },
            "name": {
              "type": "string",
            },
          },
          "required": [
            "latitude",
            "longitude",
          ],
          "type": "object",
        },
        "reaction": {
          "additionalProperties": false,
          "description": "Reação quando type='reaction'.",
          "properties": {
            "emoji": {
              "description": "Emoji; string vazia retira a reação.",
              "type": "string",
            },
            "message_id": {
              "description": "UUID interno ou wamid da mensagem RECEBIDA do contato (até 30 dias).",
              "type": "string",
            },
          },
          "required": [
            "message_id",
            "emoji",
          ],
          "type": "object",
        },
        "template": {
          "additionalProperties": false,
          "description": "Objeto do template quando type='template'. Exige name e language.code.",
          "properties": {
            "components": {
              "description": "Componentes com parâmetros (header/body/button) no formato da Cloud API.",
              "items": {
                "additionalProperties": {},
                "type": "object",
              },
              "type": "array",
            },
            "language": {
              "additionalProperties": false,
              "description": "Idioma no formato da Cloud API: { code, policy? }.",
              "properties": {
                "code": {
                  "description": "Código de idioma, ex.: pt_BR.",
                  "type": "string",
                },
                "policy": {
                  "description": "Política de idioma da Cloud API (ex.: deterministic).",
                  "type": "string",
                },
              },
              "required": [
                "code",
              ],
              "type": "object",
            },
            "name": {
              "description": "Nome do template APROVADO na Meta.",
              "type": "string",
            },
          },
          "required": [
            "name",
            "language",
          ],
          "type": "object",
        },
        "text": {
          "additionalProperties": false,
          "description": "Conteúdo de texto quando type='text'.",
          "properties": {
            "body": {
              "type": "string",
            },
          },
          "required": [
            "body",
          ],
          "type": "object",
        },
        "to": {
          "description": "Destinatário: telefone E.164 (ex.: 5511999999999) ou wa_id.",
          "type": "string",
        },
        "type": {
          "description": "Tipo da mensagem. interactive, location e reaction são mensagens livres (exigem janela de 24h aberta).",
          "enum": [
            "text",
            "template",
            "interactive",
            "location",
            "reaction",
          ],
          "type": "string",
        },
      },
      "required": [
        "to",
        "type",
      ],
      "type": "object",
    },
    "outputSchema": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "additionalProperties": false,
      "properties": {
        "error": {
          "additionalProperties": false,
          "description": "Erro estruturado sem credenciais, tokens ou headers de request.",
          "properties": {
            "code": {
              "description": "Código estável do erro da API BotoZap.",
              "type": "string",
            },
            "message": {
              "description": "Mensagem segura e acionável do erro.",
              "type": "string",
            },
            "outcome": {
              "enum": [
                "rejected",
                "accepted",
                "unknown",
              ],
              "type": "string",
            },
            "retry": {
              "enum": [
                "backoff",
                "after_correction",
                "reconcile_first",
                "unknown",
              ],
              "type": "string",
            },
            "status": {
              "description": "Status HTTP; 0 quando não houve resposta HTTP.",
              "minimum": 0,
              "type": "integer",
            },
          },
          "required": [
            "code",
            "message",
            "status",
          ],
          "type": "object",
        },
        "id": {
          "anyOf": [
            {
              "description": "UUID interno do recurso no BotoZap.",
              "format": "uuid",
              "type": "string",
            },
            {
              "type": "null",
            },
          ],
          "description": "UUID interno da Mensagem; null se a persistência best-effort falhou.",
        },
        "reaction": {
          "additionalProperties": false,
          "description": "Só em type='reaction': alvo e ação.",
          "properties": {
            "action": {
              "enum": [
                "react",
                "unreact",
              ],
              "type": "string",
            },
            "emoji": {
              "type": "string",
            },
            "message_id": {
              "$ref": "#/properties/id/anyOf/0",
            },
            "wamid": {
              "type": "string",
            },
          },
          "required": [
            "message_id",
            "wamid",
            "emoji",
            "action",
          ],
          "type": "object",
        },
        "sandbox": {
          "type": "boolean",
        },
        "sent_to": {
          "description": "Destinatário efetivamente usado após normalização de identidade.",
          "type": "string",
        },
        "status": {
          "description": "Status inicial do envio.",
          "type": "string",
        },
        "to": {
          "description": "Destinatário solicitado pelo cliente.",
          "type": "string",
        },
        "type": {
          "const": "reaction",
          "type": "string",
        },
        "wamid": {
          "description": "ID da Mensagem atribuído pelo WhatsApp/Meta.",
          "type": "string",
        },
        "warnings": {
          "items": {
            "additionalProperties": false,
            "properties": {
              "code": {
                "type": "string",
              },
              "message": {
                "type": "string",
              },
            },
            "required": [
              "code",
              "message",
            ],
            "type": "object",
          },
          "type": "array",
        },
      },
      "type": "object",
    },
  },
}
`;
