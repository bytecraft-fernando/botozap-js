exports[`MCP — send_media_message > anuncia o contrato de mídia e seus limites sem degradar o schema 1`] = `
{
  "inputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "caption": {
        "description": "Legenda para image, video ou document; audio não aceita. O Instagram não aceita legenda.",
        "maxLength": 1024,
        "minLength": 1,
        "type": "string",
      },
      "filename": {
        "description": "Nome do arquivo; aceito somente quando type='document'.",
        "maxLength": 240,
        "type": "string",
      },
      "from": {
        "description": "Origem: ID Meta ou UUID interno do Número (WhatsApp); id da conta na Meta ou UUID da Conta de canal (Instagram). Obrigatório quando há mais de uma origem do mesmo canal.",
        "type": "string",
      },
      "idempotency_key": {
        "description": "Opcional para compatibilidade. Recomendado: chave obtida em prepare_send_intent ou stage_review_reply. Reutilize em retries da mesma intenção; nunca gere outra após timeout. Recusa confirmada (outcome=rejected) libera a chave para repetir após backoff/correção. Nova intenção explícita recebe nova chave.",
        "maxLength": 200,
        "minLength": 8,
        "pattern": "^[!-~]+$",
        "type": "string",
      },
      "link": {
        "description": "URL https pública do arquivo; o BotoZap delega o download à Meta.",
        "format": "uri",
        "maxLength": 2048,
        "pattern": "^https:\\/\\/",
        "type": "string",
      },
      "to": {
        "description": "Destinatário: telefone E.164 (ex.: 5511999999999) ou wa_id no WhatsApp; IGSID do contato no Instagram.",
        "type": "string",
      },
      "type": {
        "description": "Tipo da mídia a enviar.",
        "enum": [
          "image",
          "video",
          "audio",
          "document",
        ],
        "type": "string",
      },
    },
    "required": [
      "to",
      "type",
      "link",
    ],
    "type": "object",
  },
  "outputSchema": {
    "$schema": "http://json-schema.org/draft-07/schema#",
    "additionalProperties": false,
    "properties": {
      "channel": {
        "description": "Canal do envio; ausente no WhatsApp.",
        "type": "string",
      },
      "error": {
        "additionalProperties": false,
        "description": "Erro estruturado sem credenciais, tokens ou headers de request.",
        "properties": {
          "code": {
            "description": "Código estável do erro da API BotoZap.",
            "type": "string",
          },
          "message": {
            "description": "Mensagem segura e acionável do erro.",
            "type": "string",
          },
          "outcome": {
            "enum": [
              "rejected",
              "accepted",
              "unknown",
            ],
            "type": "string",
          },
          "retry": {
            "enum": [
              "backoff",
              "after_correction",
              "reconcile_first",
              "unknown",
            ],
            "type": "string",
          },
          "status": {
            "description": "Status HTTP; 0 quando não houve resposta HTTP.",
            "minimum": 0,
            "type": "integer",
          },
        },
        "required": [
          "code",
          "message",
          "status",
        ],
        "type": "object",
      },
      "external_id": {
        "description": "Identificador da Mensagem no canal (o mid no Instagram).",
        "type": [
          "string",
          "null",
        ],
      },
      "id": {
        "anyOf": [
          {
            "description": "UUID interno do recurso no BotoZap.",
            "format": "uuid",
            "type": "string",
          },
          {
            "type": "null",
          },
        ],
        "description": "UUID interno da Mensagem; null se a persistência best-effort falhou.",
      },
      "reaction": {
        "additionalProperties": false,
        "description": "Só em type='reaction': alvo e ação.",
        "properties": {
          "action": {
            "enum": [
              "react",
              "unreact",
            ],
            "type": "string",
          },
          "emoji": {
            "type": "string",
          },
          "message_id": {
            "description": "WhatsApp: UUID interno do alvo. Instagram: mid do alvo.",
            "type": "string",
          },
          "wamid": {
            "type": "string",
          },
        },
        "required": [
          "message_id",
          "emoji",
          "action",
        ],
        "type": "object",
      },
      "sandbox": {
        "type": "boolean",
      },
      "sent_to": {
        "description": "Destinatário efetivamente usado após normalização de identidade.",
        "type": "string",
      },
      "status": {
        "description": "Status inicial do envio.",
        "type": "string",
      },
      "to": {
        "description": "Destinatário solicitado pelo cliente.",
        "type": "string",
      },
      "type": {
        "description": "WhatsApp: só em reação. Instagram: text ou o tipo da mídia.",
        "type": "string",
      },
      "wamid": {
        "description": "ID da Mensagem atribuído pelo WhatsApp/Meta; null fora do WhatsApp (use external_id).",
        "type": [
          "string",
          "null",
        ],
      },
      "warnings": {
        "items": {
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
            },
            "message": {
              "type": "string",
            },
          },
          "required": [
            "code",
            "message",
          ],
          "type": "object",
        },
        "type": "array",
      },
    },
    "type": "object",
  },
}
`;
