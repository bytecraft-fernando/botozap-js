{
  "name": "@botozap/mcp",
  "version": "0.8.2",
  "description": "Servidor MCP (Model Context Protocol) para a API pública do BotoZap — expõe as operações da plataforma WhatsApp Cloud API como ferramentas MCP para Claude Code, Cursor e Codex.",
  "license": "MIT",
  "type": "module",
  "homepage": "https://botozap.com.br",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bytecraft-fernando/botozap-js.git",
    "directory": "packages/mcp"
  },
  "bugs": {
    "url": "https://github.com/bytecraft-fernando/botozap-js/issues"
  },
  "bin": {
    "botozap-mcp": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.19"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-ui.mjs",
    "dev": "tsc -p tsconfig.json --watch",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p web/tsconfig.json --noEmit",
    "test": "vitest run",
    "start": "node dist/index.js",
    "smoke": "node scripts/smoke.ts",
    "smoke:sandbox": "node scripts/smoke-sandbox.ts",
    "prepublishOnly": "pnpm run build",
    "build:ui": "node scripts/build-ui.mjs",
    "preview:build": "node scripts/build-ui.mjs --demo",
    "demo:ui": "node scripts/demo-ui.mjs",
    "screenshots:ui": "node scripts/screenshot-ui.mjs"
  },
  "dependencies": {
    "@botozap/sdk": "workspace:*",
    "@modelcontextprotocol/ext-apps": "1.7.5",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@openai/mcp-extensions": "0.1.0",
    "pg": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.10.2",
    "@openai/apps-sdk-ui": "0.2.2",
    "@types/node": "^20.19.0",
    "@types/pg": "^8.23.1",
    "esbuild": "0.28.1",
    "happy-dom": "20.14.0",
    "playwright": "1.56.1",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
